9:["$","section","Refund Policy",{"className":"border-b border-ink/10 py-10","children":[["$","h2",null,{"children":"Refund Policy"}],["$","p",null,{"className":"mt-5","children":"All registration fees and franchise fees are strictly non-refundable. Once payment has been processed and any administrative, verification, or league operations have commenced, no refunds will be issued under any circumstances including cancellation, withdrawal, non-participation, or ineligibility. Players and franchise owners acknowledge that all payments are final and binding at the time of submission. Payments for Apex Premier League are processed and managed under the authorized operations of Farhana Begum."}]]}]
